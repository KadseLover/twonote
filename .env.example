# ============================================================
# TwoNote – Umgebungsvariablen
# Kopiere diese Datei zu .env und befülle alle Werte
# ============================================================

# --- Google Drive (OAuth2) ---
# 1. In Google Cloud Console: Credentials → OAuth 2.0 Client ID → Desktop app erstellen
# 2. python3 get_refresh_token.py ausführen → gibt die drei Werte unten aus
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ID des Google Drive Ordners, in dem die Dokumente gespeichert werden
# (aus der URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# --- Gemini API ---
# Kostenloser API Key von https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Tägliches Free-Tier-Limit (Requests/Tag) – nur für die Verbrauchsanzeige.
# Aktueller Free-Tier-Wert für gemini-2.5-flash: 1500. Bei Bedarf anpassen.
GEMINI_DAILY_LIMIT=1500

# --- JWT Authentifizierung ---
# Zufälliger, langer geheimer Schlüssel (z.B. mit: openssl rand -hex 32)
JWT_SECRET_KEY=change_me_to_a_random_secret_key
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Erlaubte Frontend-Origins (kommagetrennt für mehrere)
# - Lokal:     http://localhost:8080
# - Tunnel:    https://twonote.deine-domain.de
CORS_ORIGINS=http://localhost:8080,https://twonote.deine-domain.de
