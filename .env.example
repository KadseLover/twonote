# ============================================================
# TwoNote – Umgebungsvariablen
# Kopiere diese Datei zu .env und befülle alle Werte
# ============================================================

# Dateien werden lokal auf dem Server unter data/files/ gespeichert
# (Docker-Volume backend_data:/app/data) – keine Cloud-Konfiguration nötig.

# --- Gemini API ---
# Kostenloser API Key von https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Tägliches Free-Tier-Limit (Requests/Tag) – nur für die Verbrauchsanzeige.
# Aktueller Free-Tier-Wert für gemini-2.5-flash: 1500. Bei Bedarf anpassen.
GEMINI_DAILY_LIMIT=1500

# --- JWT Authentifizierung ---
# Zufälliger, langer geheimer Schlüssel (z.B. mit: openssl rand -hex 32)
JWT_SECRET_KEY=change_me_to_a_random_secret_key
JWT_EXPIRE_MINUTES=1440

# --- OnlyOffice Document Server ---
# Geteiltes Geheimnis Backend <-> Document Server (muss exakt übereinstimmen).
# Erzeugen z.B. mit: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=change_me_to_a_random_secret_key
# Öffentliche URL des Document Servers (vom Browser erreichbar – lädt den Editor).
# - Lokal:  http://localhost:8082
# - Prod:   https://office.crxe.de  (eigene Subdomain/Tunnel-Route mit TLS)
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
# Backend-URL aus Sicht des Document Servers (Docker-internes DNS, i.d.R. unverändert lassen).
BACKEND_INTERNAL_URL=http://backend:8000
# Öffentliche Basis-URL der App (vom Browser erreichbar) – wird für die Profilbild-
# URLs im OnlyOffice-Editor genutzt. Leer lassen = automatisch aus den Request-Headern
# ableiten (reicht lokal). Hinter HTTPS-Proxy/Caddy explizit setzen:
# - Lokal:  http://localhost:8080  (oder leer lassen)
# - Prod:   https://twonote.deine-domain.de
APP_PUBLIC_URL=

# --- CORS ---
# Erlaubte Frontend-Origins (kommagetrennt für mehrere)
# - Lokal:     http://localhost:8080
# - Tunnel:    https://twonote.deine-domain.de
CORS_ORIGINS=http://localhost:8080,https://twonote.deine-domain.de
